rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read for website assets (customers must be able to view perfume & banner images)
    // Authenticated users (admins) can upload, update, and delete images
    match /{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }
  }
}
